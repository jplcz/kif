" Vim syntax file
" Language: kif (procedural kobj interface language), see docs/kif-proc-language.md
" The word lists between the GEN markers are generated by kif-editor/gen_syntax.py; everything else is hand-written.
if exists('b:current_syntax')
  finish
endif

syn case match

" defined first: when two matches start at the same column the later definition wins
syn match   kifOperator     "->\|=>\|::\|\.\.=\?\|&&\|||\|<<=\?\|>>=\?\|[-+*/%&|^!<>=]=\?\|?"
syn match   kifComment      "//.*$" contains=kifTodo
syn match   kifDocComment   "///.*$" contains=kifTodo
syn keyword kifTodo         TODO FIXME XXX contained

" Raw blocks: header(c) { ... }, code(cxx) { ... }, m_prolog { ... }; the body ends at a '}' alone in column 1.
" The tag picks the embedded language (no tag: C).
" GEN-BEGIN verbatim
let s:verbatim = 'header|code|m_prolog|m_epilog'
" GEN-END verbatim
let s:words = '\%(' . substitute(s:verbatim, '|', '\\|', 'g') . '\)'
unlet! b:current_syntax
syn include @kifC syntax/c.vim
unlet! b:current_syntax
syn include @kifCpp syntax/cpp.vim
unlet! b:current_syntax
execute 'syn region kifVerbatimCxx matchgroup=kifVerbatimKw start="^\s*' . s:words . '\s*(\s*cxx\s*)\s*{\s*$" end="^}\s*$" contains=@kifCpp keepend'
execute 'syn region kifVerbatim matchgroup=kifVerbatimKw start="^\s*' . s:words . '\s*\%((\s*c\s*)\)\?\s*{\s*$" end="^}\s*$" contains=@kifC keepend'

syn region  kifAttribute    matchgroup=kifAttrDelim start="#!\?\[" end="\]" contains=kifString,kifNumber,kifAttrName,kifConstant,kifType
syn match   kifAttrName     "\<[a-z_][a-z0-9_]*\>\ze\s*[(,\]=]" contained

syn region  kifString       start=+"+ skip=+\\\\\|\\"+ end=+"+ contains=kifEscape
syn match   kifEscape       +\\\%([ntr0\\"]\|x\x\x\)+ contained
syn match   kifNumber       "\<\%(0[xX][0-9a-fA-F_]\+\|0[bB][01_]\+\|0[oO][0-7_]\+\|\d[0-9_]*\)\%([iu]\%(8\|16\|32\|64\|size\)\)\?\>"
syn match   kifLifetime     "'[A-Za-z_][A-Za-z0-9_]*\>"
syn match   kifInclude      "\%(\<include\>\s*\)\@<=<[^>]*>"
syn match   kifMacro        "\<[A-Za-z_][A-Za-z0-9_]*!\ze\s*[(\[{]"

syn match   kifInterface    "\%(\<interface\>\s\+\)\@<=[A-Za-z_][A-Za-z0-9_]*"
syn match   kifTypeName     "\%(\<\%(struct\|enum\|type\|impl\|foreign\s\+class\)\>\s\+\)\@<=[A-Za-z_][A-Za-z0-9_]*"
syn match   kifFunction     "\%(\<\%(fn\|method\|macro\)\>\s\+\)\@<=[A-Za-z_][A-Za-z0-9_]*"
syn match   kifConstName    "\%(\<const\>\s\+\)\@<=[A-Za-z_][A-Za-z0-9_]*"
syn match   kifNamespace    "\%(\<namespace\>\s\+\)\@<=[A-Za-z_][A-Za-z0-9_:]*"
syn match   kifParam        "\<[A-Za-z_][A-Za-z0-9_]*\ze\s*:\%(:\)\@!"

" GEN-BEGIN words
syn keyword kifKeyword      after as before break cfg class const continue default else enum export extern fn
syn keyword kifKeyword      for foreign gen if impl import in include interface let loop macro match method
syn keyword kifKeyword      mut namespace override private return static struct type unsafe use while
syn keyword kifConstant     true false
syn keyword kifSelf         self Self
syn keyword kifType         void bool char i8 i16 i32 i64 u8 u16 u32 u64 usize isize
" GEN-END words

hi def link kifComment      Comment
hi def link kifDocComment   SpecialComment
hi def link kifTodo         Todo
hi def link kifAttrDelim    PreProc
hi def link kifAttrName     PreProc
hi def link kifString       String
hi def link kifEscape       SpecialChar
hi def link kifNumber       Number
hi def link kifLifetime     Special
hi def link kifInclude      String
hi def link kifMacro        Macro
hi def link kifKeyword      Keyword
hi def link kifConstant     Constant
hi def link kifSelf         Identifier
hi def link kifVerbatimKw   PreProc
hi def link kifType         Type
hi def link kifInterface    Type
hi def link kifTypeName     Type
hi def link kifFunction     Function
hi def link kifConstName    Constant
hi def link kifNamespace    Include
hi def link kifParam        Identifier
hi def link kifOperator     Operator

let b:current_syntax = 'kif'
