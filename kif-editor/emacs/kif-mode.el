;;; kif-mode.el --- Major mode for kif (procedural kobj interface language) files  -*- lexical-binding: t; -*-

;; Version: 0.2.0
;; Package-Requires: ((emacs "26.1"))
;; Keywords: languages
;; SPDX-License-Identifier: BSD-2-Clause

;;; Commentary:

;; Syntax highlighting, '//' comments and brace indentation for .kif files (see docs/kif-proc-language.md).
;; Raw blocks (header(c) { } / code(cxx) { } / m_prolog { }) are highlighted as plain text; use
;; `kif-mode-verbatim-face' to adjust.  The word lists between the GEN markers are generated by
;; kif-editor/gen_syntax.py.
;;
;; Install: (add-to-list 'load-path "/path/to/kif/kif-editor/emacs") (require 'kif-mode)

;;; Code:

(defgroup kif nil "Major mode for kif files." :group 'languages)

(defcustom kif-indent-offset 4 "Indentation width inside braces (`python3 -m kiflang.kif fmt' uses 4)." :type 'integer :group 'kif)

(defface kif-mode-verbatim-face '((t :inherit font-lock-string-face))
  "Face for the body of raw blocks." :group 'kif)

;; GEN-BEGIN words
(defconst kif--keywords
  '("after" "as" "before" "break" "cfg" "class" "const" "continue" "default" "else" "enum" "export"
    "extern" "fn" "for" "foreign" "gen" "if" "impl" "import" "in" "include" "interface" "let" "loop"
    "macro" "match" "method" "mut" "namespace" "override" "private" "return" "static" "struct" "type"
    "unsafe" "use" "while"))

(defconst kif--constants
  '("true" "false"))

(defconst kif--self
  '("self" "Self"))

(defconst kif--types
  '("void" "bool" "char" "i8" "i16" "i32" "i64" "u8" "u16" "u32" "u64" "usize" "isize"))

(defconst kif--verbatim
  '("header" "code" "m_prolog" "m_epilog"))
;; GEN-END words

(defconst kif--ident "[A-Za-z_][A-Za-z0-9_]*")

(defvar kif-mode-font-lock-keywords
  `(;; raw blocks first so nothing else colours their body (the body ends at a '}' in column 1)
    (,(concat "^[ \t]*" (regexp-opt kif--verbatim t) "[ \t]*\\(?:([ \t]*[a-z]+[ \t]*)\\)?[ \t]*{[ \t]*\n\\(\\(?:.*\n\\)*?\\)}[ \t]*$")
     (2 'kif-mode-verbatim-face t))
    ("///.*$" . font-lock-doc-face)
    (,(concat "\\_<\\(?:interface\\|struct\\|enum\\|type\\|impl\\)\\_>[ \t]+\\(" kif--ident "\\)") 1 font-lock-type-face)
    (,(concat "\\_<foreign[ \t]+class\\_>[ \t]+\\(" kif--ident "\\)") 1 font-lock-type-face)
    (,(concat "\\_<\\(?:fn\\|method\\|macro\\)\\_>[ \t]+\\(" kif--ident "\\)") 1 font-lock-function-name-face)
    (,(concat "\\_<const\\_>[ \t]+\\(" kif--ident "\\)") 1 font-lock-constant-face)
    (,(concat "\\_<namespace\\_>[ \t]+\\(" kif--ident "\\(?:::" kif--ident "\\)*\\)") 1 font-lock-constant-face)
    (,(concat "\\_<\\(" kif--ident "\\)!") 1 font-lock-preprocessor-face)
    (,(concat "\\_<\\(" kif--ident "\\)[ \t]*:\\(?:[^:]\\|$\\)") 1 font-lock-variable-name-face)
    ("#!?\\[\\|\\]" . font-lock-preprocessor-face)
    ("'[A-Za-z_][A-Za-z0-9_]*\\_>" . font-lock-type-face)
    ("\\_<\\(?:0[xX][0-9a-fA-F_]+\\|0[bB][01_]+\\|0[oO][0-7_]+\\|[0-9][0-9_]*\\)\\(?:[iu]\\(?:8\\|16\\|32\\|64\\|size\\)\\)?\\_>"
     . font-lock-constant-face)
    (,(regexp-opt kif--keywords 'symbols) . font-lock-keyword-face)
    (,(regexp-opt kif--constants 'symbols) . font-lock-constant-face)
    (,(regexp-opt kif--self 'symbols) . font-lock-variable-name-face)
    (,(regexp-opt kif--types 'symbols) . font-lock-type-face)
    ("->\\|=>\\|::" . font-lock-builtin-face))
  "Font-lock rules for `kif-mode'.")

(defvar kif-mode-syntax-table
  (let ((st (make-syntax-table)))
    (modify-syntax-entry ?/ ". 12" st)
    (modify-syntax-entry ?\n ">" st)
    (modify-syntax-entry ?_ "_" st)
    (modify-syntax-entry ?\" "\"" st)
    (modify-syntax-entry ?\\ "\\" st)
    ;; a lifetime tick is not a string delimiter
    (modify-syntax-entry ?' "_" st)
    (modify-syntax-entry ?< "(>" st)
    (modify-syntax-entry ?> ")<" st)
    st)
  "Syntax table for `kif-mode'.")

(defun kif-indent-line ()
  "Indent the current line by brace depth."
  (interactive)
  (let ((depth (save-excursion
                 (back-to-indentation)
                 (let ((d (car (syntax-ppss))))
                   (if (looking-at-p "}") (max 0 (1- d)) d)))))
    (indent-line-to (* depth kif-indent-offset))))

;;;###autoload
(define-derived-mode kif-mode prog-mode "kif"
  "Major mode for editing kif (procedural kobj interface language) files."
  :syntax-table kif-mode-syntax-table
  (setq-local comment-start "// ")
  (setq-local comment-end "")
  (setq-local indent-line-function #'kif-indent-line)
  (setq-local font-lock-defaults '(kif-mode-font-lock-keywords nil nil nil nil
                                   (font-lock-multiline . t))))

;;;###autoload
(add-to-list 'auto-mode-alist '("\\.kif\\'" . kif-mode))

(provide 'kif-mode)
;;; kif-mode.el ends here
