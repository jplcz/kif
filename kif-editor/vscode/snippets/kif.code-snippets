{
  "main": {
    "prefix": "main",
    "description": "program entry point: argv arrives as a slice of string views (hosted targets)",
    "body": ["fn main(args: &[str_view]) -> i32 {", "    $0", "    0", "}"]
  },
  "kobj interface": {
    "prefix": "kobj",
    "description": "kobj interface (class-table dispatched, usable from C and .m)",
    "body": ["#[kobj, self(${1:device_t})]", "interface ${2:name} {", "    // ${3:what the method does}", "    method ${4:op}($5) -> ${6:i32};", "}"]
  },
  "plain interface": {
    "prefix": "interface",
    "description": "plain interface",
    "body": ["interface ${1:name} {", "    method ${2:op}($3) -> ${4:i32};", "}"]
  },
  "method": {
    "prefix": "method",
    "description": "interface method (abstract)",
    "body": ["method ${1:name}(${2:arg}: ${3:u32}) -> ${4:i32};"]
  },
  "method with default": {
    "prefix": "methoddef",
    "description": "interface method with a default body",
    "body": ["method ${1:name}(${2:arg}: ${3:u32}) -> ${4:i32} { ${5:0} }"]
  },
  "static method": {
    "prefix": "static",
    "description": "static interface method",
    "body": ["static method ${1:name}($2) -> ${3:i32};"]
  },
  "before hook": {
    "prefix": "before",
    "description": "m_prolog-style hook run before the next method",
    "body": ["before { $0 }"]
  },
  "after hook": {
    "prefix": "after",
    "description": "hook run after the next method",
    "body": ["after { $0 }"]
  },
  "m_prolog": {
    "prefix": "m_prolog",
    "description": "raw C emitted before the next method (the closing brace must be in column 1)",
    "body": ["m_prolog {", "$0", "}"]
  },
  "m_epilog": {
    "prefix": "m_epilog",
    "description": "raw C emitted after the next method (the closing brace must be in column 1)",
    "body": ["m_epilog {", "$0", "}"]
  },
  "fn": {
    "prefix": "fn",
    "description": "function",
    "body": ["fn ${1:name}(${2:arg}: ${3:u32}) -> ${4:u32} {", "    $0", "}"]
  },
  "private fn": {
    "prefix": "pfn",
    "description": "private function",
    "body": ["private fn ${1:name}($2) -> ${3:u32} {", "    $0", "}"]
  },
  "generic fn": {
    "prefix": "gen",
    "description": "generic function",
    "body": ["gen fn ${1:name}<${2:T}>(${3:x}: ${2:T}) -> ${2:T} {", "    $0", "}"]
  },
  "extern fn": {
    "prefix": "extern",
    "description": "foreign C function declaration",
    "body": ["extern \"C\" fn ${1:name}($2) -> ${3:i32};"]
  },
  "struct": {
    "prefix": "struct",
    "description": "struct",
    "body": ["struct ${1:name} {", "    ${2:field}: ${3:u32},", "}"]
  },
  "enum": {
    "prefix": "enum",
    "description": "enum with explicit values",
    "body": ["enum ${1:name}: ${2:u8} {", "    ${3:first} = 0,", "    ${4:second} = 1,", "}"]
  },
  "flags enum": {
    "prefix": "flags",
    "description": "bit-flag enum",
    "body": ["#[flags]", "enum ${1:name}: ${2:u32} {", "    none = 0,", "    ${3:a} = 1,", "    ${4:b} = 2,", "}"]
  },
  "impl for": {
    "prefix": "impl",
    "description": "implement an interface for a type",
    "body": ["impl ${1:iface} for ${2:target} {", "    fn ${3:op}(&self) -> ${4:i32} { $0 }", "}"]
  },
  "const": {
    "prefix": "const",
    "description": "constant",
    "body": ["const ${1:NAME}: ${2:u32} = ${3:0};"]
  },
  "type alias": {
    "prefix": "type",
    "description": "type alias",
    "body": ["type ${1:name} = ${2:u64};"]
  },
  "namespace": {
    "prefix": "namespace",
    "description": "namespace declaration",
    "body": ["namespace ${1:vendor}::${2:name};"]
  },
  "import": {
    "prefix": "import",
    "description": "import another .kif file",
    "body": ["import \"${1:file.kif}\";"]
  },
  "use": {
    "prefix": "use",
    "description": "bring a name into scope",
    "body": ["use ${1:module}::${2:name};"]
  },
  "header(c)": {
    "prefix": "headerc",
    "description": "raw C copied into the generated header (the closing brace must be in column 1)",
    "body": ["header(c) {", "$0", "}"]
  },
  "code(c)": {
    "prefix": "codec",
    "description": "raw C copied into the generated source (the closing brace must be in column 1)",
    "body": ["code(c) {", "$0", "}"]
  },
  "header(cxx)": {
    "prefix": "headercxx",
    "description": "raw C++ copied into the generated header (the closing brace must be in column 1)",
    "body": ["header(cxx) {", "$0", "}"]
  },
  "code(cxx)": {
    "prefix": "codecxx",
    "description": "raw C++ copied into the generated source (the closing brace must be in column 1)",
    "body": ["code(cxx) {", "$0", "}"]
  },
  "if": {
    "prefix": "if",
    "description": "if expression",
    "body": ["if ${1:cond} {", "    $0", "}"]
  },
  "while": {
    "prefix": "while",
    "description": "while loop",
    "body": ["while ${1:cond} {", "    $0", "}"]
  },
  "for range": {
    "prefix": "for",
    "description": "for loop over a range",
    "body": ["for ${1:i} in ${2:0}..${3:n} {", "    $0", "}"]
  },
  "match": {
    "prefix": "match",
    "description": "match expression",
    "body": ["match ${1:value} {", "    ${2:0} => ${3:1},", "    _ => ${4:2},", "}"]
  },
  "let mut": {
    "prefix": "letm",
    "description": "mutable binding",
    "body": ["let mut ${1:name} = ${2:0};"]
  }
}
