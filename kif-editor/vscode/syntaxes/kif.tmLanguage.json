{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Generated by kif-editor/gen_syntax.py from the compiler's word lists; do not edit.",
  "name": "kif",
  "scopeName": "source.kif",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#verbatim"
    },
    {
      "include": "#include-path"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#lifetime"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#macro-call"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#self"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#parameter"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.documentation.kif",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.kif",
          "match": "//.*$"
        }
      ]
    },
    "verbatim": {
      "patterns": [
        {
          "begin": "^\\s*(header|code|m_prolog|m_epilog)\\s*(\\()\\s*(cxx)\\s*(\\))\\s*(\\{)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.verbatim.kif"
            },
            "2": {
              "name": "punctuation.section.parens.begin.kif"
            },
            "3": {
              "name": "entity.name.tag.language.kif"
            },
            "4": {
              "name": "punctuation.section.parens.end.kif"
            },
            "5": {
              "name": "punctuation.section.block.begin.kif"
            }
          },
          "end": "^(\\})[ \\t]*$",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.block.end.kif"
            }
          },
          "contentName": "meta.embedded.block.cpp",
          "patterns": [
            {
              "include": "source.cpp"
            }
          ]
        },
        {
          "begin": "^\\s*(header|code|m_prolog|m_epilog)\\s*(\\()\\s*(c)\\s*(\\))\\s*(\\{)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.verbatim.kif"
            },
            "2": {
              "name": "punctuation.section.parens.begin.kif"
            },
            "3": {
              "name": "entity.name.tag.language.kif"
            },
            "4": {
              "name": "punctuation.section.parens.end.kif"
            },
            "5": {
              "name": "punctuation.section.block.begin.kif"
            }
          },
          "end": "^(\\})[ \\t]*$",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.block.end.kif"
            }
          },
          "contentName": "meta.embedded.block.c",
          "patterns": [
            {
              "include": "source.c"
            }
          ]
        },
        {
          "begin": "^\\s*(header|code|m_prolog|m_epilog)\\s*(\\{)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.verbatim.kif"
            },
            "2": {
              "name": "punctuation.section.block.begin.kif"
            }
          },
          "end": "^(\\})[ \\t]*$",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.block.end.kif"
            }
          },
          "contentName": "meta.embedded.block.c",
          "patterns": [
            {
              "include": "source.c"
            }
          ]
        }
      ]
    },
    "include-path": {
      "match": "\\b(include)\\b\\s*(<[^>\\n]*>)",
      "captures": {
        "1": {
          "name": "keyword.control.import.kif"
        },
        "2": {
          "name": "string.quoted.other.lt-gt.include.kif"
        }
      }
    },
    "attribute": {
      "begin": "(#!?\\[)",
      "end": "(\\])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.attribute.kif"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.attribute.kif"
        }
      },
      "name": "meta.attribute.kif",
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#constant"
        },
        {
          "match": "\\b(align|allocates|atomic_callback|atomic_entry|atomic_exempt|atomic_lock|atomic_only|atomic_scope|atomic_token|caller_location|checked|copy|count|cxx_name|derive|ensures|enter_atomic|export|extends|flags|foreign|format|forward_args|header|heap|inline|kobj|lang|leave_atomic|len_ge|len_of|link_name|lt_len|might_sleep|no_prefix|non_empty|non_null|operator|ops|per_cpu|preserves|provided|repr|safe|self|send|small_stack|some|stack|sync|target|tls|trace|track_caller|typedef|unchecked_form|unsafe|version|visibility|when|zeroable)\\b(?=\\s*[(,\\]=]|\\s*$)",
          "name": "entity.other.attribute-name.kif"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*[(,\\]=])",
          "name": "entity.other.attribute-name.unknown.kif"
        },
        {
          "include": "#type"
        }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.kif",
      "patterns": [
        {
          "name": "constant.character.escape.kif",
          "match": "\\\\(?:[ntr0\\\\\\\"]|x[0-9a-fA-F]{2})"
        },
        {
          "name": "invalid.illegal.escape.kif",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "name": "constant.numeric.kif",
      "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*)(?:[iu](?:8|16|32|64|size))?\\b"
    },
    "lifetime": {
      "name": "storage.modifier.lifetime.kif",
      "match": "'[A-Za-z_][A-Za-z0-9_]*\\b"
    },
    "constant": {
      "name": "constant.language.kif",
      "match": "\\b(true|false)\\b"
    },
    "self": {
      "name": "variable.language.self.kif",
      "match": "\\b(self|Self)\\b"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(interface)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.interface.kif"
            },
            "2": {
              "name": "entity.name.type.interface.kif"
            }
          }
        },
        {
          "match": "\\b(struct)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.struct.kif"
            },
            "2": {
              "name": "entity.name.type.struct.kif"
            }
          }
        },
        {
          "match": "\\b(enum)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.enum.kif"
            },
            "2": {
              "name": "entity.name.type.enum.kif"
            }
          }
        },
        {
          "match": "\\b(type)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.kif"
            },
            "2": {
              "name": "entity.name.type.alias.kif"
            }
          }
        },
        {
          "match": "\\b(method)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.method.kif"
            },
            "2": {
              "name": "entity.name.function.method.kif"
            }
          }
        },
        {
          "match": "\\b(fn|macro)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.kif"
            },
            "2": {
              "name": "entity.name.function.kif"
            }
          }
        },
        {
          "match": "\\b(const)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.const.kif"
            },
            "2": {
              "name": "entity.name.constant.kif"
            }
          }
        },
        {
          "match": "\\b(foreign\\s+class)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.foreign.kif"
            },
            "2": {
              "name": "entity.name.type.class.kif"
            }
          }
        },
        {
          "match": "\\b(impl)\\b\\s+(?:([A-Za-z_][A-Za-z0-9_]*)\\s+(for)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.impl.kif"
            },
            "2": {
              "name": "entity.name.type.interface.kif"
            },
            "3": {
              "name": "keyword.other.kif"
            },
            "4": {
              "name": "entity.name.type.kif"
            }
          }
        },
        {
          "match": "\\b(namespace)\\b\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.namespace.kif"
            },
            "2": {
              "name": "entity.name.namespace.kif"
            }
          }
        }
      ]
    },
    "keyword": {
      "match": "\\b(after|as|before|break|cfg|class|const|continue|default|else|enum|export|extern|fn|for|foreign|gen|if|impl|import|in|include|interface|let|loop|macro|match|method|mut|namespace|override|private|return|static|struct|type|unsafe|use|while)\\b",
      "name": "keyword.other.kif"
    },
    "type": {
      "match": "\\b(void|bool|char|i8|i16|i32|i64|u8|u16|u32|u64|usize|isize)\\b",
      "name": "support.type.builtin.kif"
    },
    "macro-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)!(?=\\s*[(\\[{])",
      "name": "support.function.macro.kif"
    },
    "parameter": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
      "captures": {
        "1": {
          "name": "variable.parameter.kif"
        },
        "2": {
          "name": "punctuation.separator.colon.kif"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "match": "->|=>",
          "name": "keyword.operator.arrow.kif"
        },
        {
          "match": "::",
          "name": "punctuation.separator.namespace.kif"
        },
        {
          "match": "\\.\\.=?|\\.\\.\\.",
          "name": "keyword.operator.range.kif"
        },
        {
          "match": "<<=?|>>=?|&&|\\|\\||[-+*/%&|^]=|[=!<>]=|[-+*/%&|^!<>=?]",
          "name": "keyword.operator.kif"
        }
      ]
    }
  }
}
