%YAML 1.2
---
# Sublime Text syntax for kif (procedural kobj interface language), see docs/kif-proc-language.md
# The word lists between the GEN markers are generated by kif-editor/gen_syntax.py.
name: kif
file_extensions: [kif]
scope: source.kif

variables:
  ident: '[A-Za-z_][A-Za-z0-9_]*'
# GEN-BEGIN verbatim
  verbatim_words: 'header|code|m_prolog|m_epilog'
# GEN-END verbatim

contexts:
  main:
    - include: comments
    - include: verbatim
    - match: '\b(include)\b\s*(<[^>\n]*>)'
      captures:
        1: keyword.control.import.kif
        2: string.quoted.other.lt-gt.include.kif
    - include: attributes
    - include: strings
    - match: '\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*)(?:[iu](?:8|16|32|64|size))?\b'
      scope: constant.numeric.kif
    - match: "'{{ident}}\\b"
      scope: storage.modifier.lifetime.kif
    - match: '\b(interface)\b\s+({{ident}})'
      captures:
        1: keyword.declaration.interface.kif
        2: entity.name.type.interface.kif
    - match: '\b(struct|enum|type)\b\s+({{ident}})'
      captures:
        1: keyword.declaration.type.kif
        2: entity.name.type.kif
    - match: '\b(impl)\b\s+(?:({{ident}})\s+(for)\s+)?({{ident}})'
      captures:
        1: keyword.declaration.impl.kif
        2: entity.name.type.interface.kif
        3: keyword.other.kif
        4: entity.name.type.kif
    - match: '\b(foreign)\s+(class)\b\s+({{ident}})'
      captures:
        1: keyword.declaration.foreign.kif
        2: keyword.declaration.class.kif
        3: entity.name.type.class.kif
    - match: '\b(fn|method|macro)\b\s+({{ident}})'
      captures:
        1: keyword.declaration.function.kif
        2: entity.name.function.kif
    - match: '\b(const)\b\s+({{ident}})'
      captures:
        1: keyword.declaration.const.kif
        2: entity.name.constant.kif
    - match: '\b(namespace)\b\s+({{ident}}(?:::{{ident}})*)'
      captures:
        1: keyword.declaration.namespace.kif
        2: entity.name.namespace.kif
    - match: '\b({{ident}})!(?=\s*[(\[{])'
      scope: support.function.macro.kif
    - match: '\b({{ident}})\s*(:)(?!:)'
      captures:
        1: variable.parameter.kif
        2: punctuation.separator.colon.kif
# GEN-BEGIN words
    - match: '\b(true|false)\b'
      scope: constant.language.kif
    - match: '\b(self|Self)\b'
      scope: variable.language.kif
    - match: '\b(after|as|before|break|cfg|class|const|continue|default|else|enum|export|extern|fn|for|foreign|gen|if|impl|import|in|include|interface|let|loop|macro|match|method|mut|namespace|override|private|return|static|struct|type|unsafe|use|while)\b'
      scope: keyword.other.kif
    - match: '\b(void|bool|char|i8|i16|i32|i64|u8|u16|u32|u64|usize|isize)\b'
      scope: support.type.builtin.kif
# GEN-END words
    - match: '->|=>'
      scope: keyword.operator.arrow.kif
    - match: '::'
      scope: punctuation.separator.namespace.kif
    - match: '\.\.=?|\.\.\.'
      scope: keyword.operator.range.kif
    - match: '<<=?|>>=?|&&|\|\||[-+*/%&|^]=|[=!<>]=|[-+*/%&|^!<>=?]'
      scope: keyword.operator.kif

  comments:
    - match: '///'
      scope: punctuation.definition.comment.kif
      push:
        - meta_scope: comment.line.documentation.kif
        - match: '$\n?'
          pop: true
    - match: '//'
      scope: punctuation.definition.comment.kif
      push:
        - meta_scope: comment.line.double-slash.kif
        - match: '$\n?'
          pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.kif
      push:
        - meta_include_prototype: false
        - meta_scope: string.quoted.double.kif
        - match: '\\(?:[ntr0\\"]|x[0-9a-fA-F]{2})'
          scope: constant.character.escape.kif
        - match: '\\.'
          scope: invalid.illegal.escape.kif
        - match: '"'
          scope: punctuation.definition.string.end.kif
          pop: true

  attributes:
    - match: '#!?\['
      scope: punctuation.definition.attribute.kif
      push:
        - meta_scope: meta.attribute.kif
        - match: '\]'
          scope: punctuation.definition.attribute.kif
          pop: true
        - include: strings
        - match: '\b(?:0[xX][0-9a-fA-F_]+|[0-9][0-9_]*)\b'
          scope: constant.numeric.kif
        - match: '\b{{ident}}\b(?=\s*[(,\]=])'
          scope: entity.other.attribute-name.kif

  # header(c) { ... } / code(cxx) { ... } / m_prolog { ... }: embedded C or C++ until a line that is only '}'.
  verbatim:
    - match: '^\s*({{verbatim_words}})\s*(\()\s*(cxx)\s*(\))\s*(\{)\s*$'
      captures:
        1: keyword.control.verbatim.kif
        2: punctuation.section.parens.begin.kif
        3: entity.name.tag.language.kif
        4: punctuation.section.parens.end.kif
        5: punctuation.section.block.begin.kif
      embed: scope:source.c++
      embed_scope: meta.embedded.block.cpp source.c++.embedded.kif
      escape: '^(\})\s*$'
      escape_captures:
        1: punctuation.section.block.end.kif
    - match: '^\s*({{verbatim_words}})\s*(?:(\()\s*(c)\s*(\))\s*)?(\{)\s*$'
      captures:
        1: keyword.control.verbatim.kif
        2: punctuation.section.parens.begin.kif
        3: entity.name.tag.language.kif
        4: punctuation.section.parens.end.kif
        5: punctuation.section.block.begin.kif
      embed: scope:source.c
      embed_scope: meta.embedded.block.c source.c.embedded.kif
      escape: '^(\})\s*$'
      escape_captures:
        1: punctuation.section.block.end.kif
