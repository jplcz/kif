# @KIF_TOOL_NAME@: launcher installed by the kif package (generated from cmake/kif-tool.sh.in).
here=$(cd "$(dirname "$0")" && pwd -P)
PYTHONPATH="$here/@KIF_PY_RELDIR@${PYTHONPATH:+:$PYTHONPATH}" exec "${PYTHON:-python3}" -m @KIF_TOOL_MODULE@ "$@"
